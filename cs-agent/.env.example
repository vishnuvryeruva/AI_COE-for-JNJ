# Copy to .env for local docker-compose runs.

# --- PostgreSQL (bundled inside the Docker image) ---
POSTGRES_DB=csagent
POSTGRES_USER=csagent
POSTGRES_PASSWORD=database123456

# --- SAP AI Core ---
# Local dev: paste the AI Core service key JSON (BTP Cockpit -> AI Core -> Create Service Key).
# On Cloud Foundry: bind an aicore service instance instead and the SDK reads VCAP_SERVICES.
# Without either, the app still runs — intent detection falls back to a keyword stub.
# AICORE_SERVICE_KEY='{"clientid":"...","clientsecret":"...","url":"...","serviceurls":{"AI_API_URL":"..."}}'
AICORE_MODEL=gpt-4o-mini

# --- Agent behaviour ---
# The mailbox CSRs forward to. Excluded when inferring which address is the mailing group.
AGENT_MAILBOX=cs-agent@medtech-ai.jnj.com
# Below this, drafts land in NEEDS_REVIEW. Nothing auto-sends at any confidence.
CONFIDENCE_THRESHOLD=0.75

# --- Microsoft Graph / Outlook (delegated sign-in) ---
# Leave these blank to run without Outlook — the app hides all Outlook features
# and works exactly as before (upload / paste / scenarios). Set them to light up
# "Sign in with Microsoft", the inbox picker, and real sending.
#
# Get them by registering an app in Azure AD (Entra):
#   - a dev tenant you own (fastest — you're the admin), or
#   - the J&J tenant (needs J&J IT — see JNJ-IT-App-Registration-Request.md)
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_TENANT_ID=common          # dev multi-tenant; J&J gives a specific GUID
# AZURE_REDIRECT_URI=http://localhost:8080/api/v1/auth/callback
# AZURE_POST_LOGIN_URI=/
# Signs session cookies — set a long random value in any real deployment.
# COOKIE_SECRET=change-me-to-a-long-random-string

# --- Frontend (only for local `npm run dev`; Docker build uses same-origin /api/v1) ---
# VITE_API_URL=http://localhost:3000/api/v1

# Copy to .env for local docker-compose runs.

# --- PostgreSQL (bundled inside the Docker image) ---
POSTGRES_DB=csagent
POSTGRES_USER=csagent
POSTGRES_PASSWORD=database123456

# --- SAP AI Core ---
# Local dev: paste the AI Core service key JSON (BTP Cockpit -> AI Core -> Create Service Key).
# On Cloud Foundry: bind an aicore service instance instead and the SDK reads VCAP_SERVICES.
# Without either, the app still runs — intent detection falls back to a keyword stub.
# AICORE_SERVICE_KEY='{"clientid":"...","clientsecret":"...","url":"...","serviceurls":{"AI_API_URL":"..."}}'
AICORE_MODEL=gpt-4o-mini

# --- Agent behaviour ---
# The mailbox CSRs forward to. Excluded when inferring which address is the mailing group.
AGENT_MAILBOX=cs-agent@medtech-ai.jnj.com
# Below this, drafts land in NEEDS_REVIEW. Nothing auto-sends at any confidence.
CONFIDENCE_THRESHOLD=0.75

# --- Showcase access ---
# Enable a separate guest session without Microsoft setup. Guests can load sample
# emails, upload .msg/.eml, review drafts and approve a demo; they cannot use
# Outlook or send mail. Each guest session has a private queue.
# The POC Compose/Cloud Foundry configuration enables this for the showcase.
# Disable it before a company-data rollout.
GUEST_DEMO_ENABLED=true
AUTH_REQUIRED=true

# --- Microsoft Graph / Outlook (delegated sign-in) ---
# With AUTH_REQUIRED=true, users must sign in with Microsoft or explicitly
# select Continue as guest when GUEST_DEMO_ENABLED=true. Set the guest flag to
# false for the company-only rollout. AUTH_REQUIRED=false is a legacy anonymous
# local mode; named guest sessions are preferred for demos.
# Set the values below to enable company sign-in, Outlook inbox/search, and
# sending after explicit review and approval. Passwords are entered at Microsoft;
# this application never collects a J&J password.
#
# J&J IT registers a single-tenant Web app in Microsoft Entra (see
# JNJ-IT-App-Registration-Request.md), restricts user/group assignments, and
# approves delegated User.Read, Mail.Read, Mail.Send plus OIDC/offline_access.
# A development tenant can use its own explicit Directory tenant GUID.
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_TENANT_ID=               # J&J Directory tenant GUID; never common
# Must match the registered Web redirect URI exactly; use HTTPS when deployed.
# AZURE_REDIRECT_URI=http://localhost:8080/api/v1/auth/callback
# Local path only (external redirects are ignored).
# AZURE_POST_LOGIN_URI=/
# Required for Microsoft sign-in: at least 32 random characters. Generate with
# `openssl rand -hex 32` and store as a deployment secret, not in source control.
# COOKIE_SECRET=
# Guest-only demos can use a random process-local signing key when this is unset;
# those guest cookies stop working after the backend restarts.
# Sessions expire server-side after eight hours. OAuth state expires in ten
# minutes. The current Postgres MSAL cache supports one backend process only;
# use protected storage and implement distributed cache locking before scaling.

# --- Frontend (only for local `npm run dev`; Docker build uses same-origin /api/v1) ---
# Vite proxies /api/v1 to the backend. For local sign-in, use:
# AZURE_REDIRECT_URI=http://localhost:5173/api/v1/auth/callback
# Register that exact Web redirect URI in Entra. Keep VITE_API_URL unset
# for same-origin cookies through Vite (or Docker on :8080).
